# Copy to .env for local experiments. Never commit real values.
# PullBeacon reads these from the process environment; it never prints them.

# GitHub token (in Actions this is the built-in GITHUB_TOKEN).
GITHUB_TOKEN=

# Provider keys: set only the one matching `model.provider` in .pullbeacon.yml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
